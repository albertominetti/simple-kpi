# Total protection of the data/ folder (config.php + kpi.sqlite).
# Compatible with Apache 2.4 and 2.2.

<IfModule mod_authz_core.c>
    # Apache 2.4
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order deny,allow
    Deny from all
</IfModule>

# Explicit block of any PHP execution / direct download of data files
# (useful even if the folder ends up inside the webroot).
<FilesMatch "\.(php|sqlite|sqlite3|db|txt|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
