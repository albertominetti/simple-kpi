# Protezione totale della cartella data/ (config.php + kpi.sqlite).
# Compatibile con Apache 2.4 e 2.2.

<IfModule mod_authz_core.c>
    # Apache 2.4
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order deny,allow
    Deny from all
</IfModule>

# Blocco esplicito di qualsiasi esecuzione PHP / download diretto
# dei file di dati (utile anche se la cartella finisse dentro la webroot).
<FilesMatch "\.(php|sqlite|sqlite3|db|txt|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
