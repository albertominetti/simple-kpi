# ---------------------------------------------------------------------------
# Basic Auth for the dashboard (and for the API GETs).
#
# WARNING (important):
#   POST /api/metrics uses the collector's Bearer token and must NOT require
#   Basic Auth. With Apache 2.4 this .htaccess protects everything except
#   POST requests (see <RequireAny> below).
#
#   If the host uses Apache 2.2 or the collector cannot POST, move this file
#   into a subfolder that contains ONLY the dashboard (e.g. /dashboard/.htaccess)
#   and leave /api/ without Basic Auth: the API GETs will then be protected
#   by the BASIC_AUTH check in config.php.
# ---------------------------------------------------------------------------

AuthType Basic
AuthName "KPI Dashboard"
AuthUserFile /path/on/server/.htpasswd
Require valid-user

# Apache 2.4: allows POST requests without Basic Auth (Bearer token).
<IfModule mod_authz_core.c>
    <RequireAny>
        Require valid-user
        Require method POST
    </RequireAny>
</IfModule>

# Apache 2.2 fallback: if it does not support "RequireAny", POST would also
# require Basic Auth. In that case move this file into a subfolder as
# explained above.
