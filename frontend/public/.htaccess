# Basic Auth for the dashboard (and for the API GETs).
# Copied to dist/ by Vite: upload it to the webroot together with dist/.
#
# Writes (POST /api/metrics, POST /api/config, POST /api/config/metrics,
# DELETE /api/config/metrics/{key}) use the Bearer token and must NOT require
# Basic Auth: with Apache 2.4 <RequireAny> + "Require method POST/DELETE" we
# exempt them. On Apache 2.2 move this file into a subfolder that contains
# only the dashboard (the API GETs will then be protected by BASIC_AUTH in
# config.php).

AuthType Basic
AuthName "KPI Dashboard"
AuthUserFile /path/on/server/.htpasswd
Require valid-user

<IfModule mod_authz_core.c>
    <RequireAny>
        Require valid-user
        Require method POST
        Require method DELETE
    </RequireAny>
</IfModule>
